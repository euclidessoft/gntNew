{% extends
    is_granted('ROLE_ADMIN') ? 'admin.html.twig' :
    is_granted('ROLE_SUPERVISEUR') ? 'admin.html.twig' :
    is_granted('ROLE_RH') ? 'rh.html.twig' :
    is_granted('ROLE_FINANCE') ? 'finance.html.twig' :
    is_granted('ROLE_CAISSIER') ? 'caisse.html.twig' :
    is_granted('ROLE_STOCK') ? 'stock.html.twig' :
    is_granted('ROLE_LIVREUR') ? 'livreur.html.twig' :
    is_granted('ROLE_EMPLOYER') ? 'employe.html.twig' :
    is_granted('ROLE_LABORATOIRE') ? 'laboratoire.html.twig' :
    'layout.html.twig'
%}
{% block title %} {{ "Commande"|trans }} - GNT Pharma {% endblock %}
{% block client_suivi %} active{% endblock %}
{% block palamares %}active{% endblock %}

{% block body %}
    <div class="container mt-4 fond-7">
        <h3 class="mt-4 mb-5 text-bold">
        <i class="fas fa-chart-line me-2"></i>
        {{ "Analyse Client"|trans }} | {{ user.nom ~ " " ~ user.prenom}} 
    </h3>
         <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link" href="{{ path('vente_chiffre_client', {'client': user.id})}}">
                {{ "Chiffre d'Affaire"|trans }}
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="{{ path('vente_client_article',{'client' :user.id}) }}">
                {{'Articles'|trans}}
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="{{ path('commande_panier_palmares_credit',{'client' :user.id}) }}">
                {{'Factures Impayées'|trans}}
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="{{ path('commande_panier_palmares_payer',{'client' :user.id}) }}">
                {{'Factures Payees'|trans}}
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link active" href="">
                {{'Compte'|trans}}
            </a>
        </li>
    </ul>
     <table class="table table-success-light table-bordered table-hover table-striped">
            <thead>
            <tr>
                <th class="text-center"> {{ 'Nº'|trans }}</th>
                <th class="text-center"> {{ 'Date'|trans }}</th>
                <th>{{ 'Compte'|trans }}</th>
                {#                <th>{{ 'Référence'|trans }}</th>#}
                <th>{{ 'Libellé'|trans }}</th>
                <th class="text-center">{{ 'Débit'|trans }}</th>
                <th class="text-center">{{ 'Crédit'|trans }}</th>
                <!-- <th class="text-center">{{ 'Solde'|trans }}</th> -->
            </tr>
            </thead>
            <tbody>
            {% set debit = 0 %}
            {% set credit = 0 %}
            {% set solde = 0 %}
            {% set i =1 %}
            {% set transfert = 0 %}
            {% for ecriture in ecritures %}
                {#                calcule solde#}
                {% if ecriture.type is null %}
                {% elseif ecriture.credit is not null %}

                    {% if ecriture.comptecredit == compte and ecriture.credit.transfert is null %}
                        {% set solde = solde + ecriture.montant %}
                        {% set credit = credit + ecriture.montant %}
                    {% else %}
                        {% set solde = solde - ecriture.montant %}
                        {% set debit = debit + ecriture.montant %}
                    {% endif %}
                {% else %}
                    {% if ecriture.comptecredit == compte and ecriture.debit.transfert is not null %}
                        {% set solde = solde + ecriture.montant %}
                        {% set credit = credit + ecriture.montant %}
                    {% else %}
                        {% set solde = solde - ecriture.montant %}
                        {% set debit = debit + ecriture.montant %}
                    {% endif %}
                {% endif %}
                {#                fin calcule#}
                {% set first = 0 %}
                {% if transfert == 0 %}
                    {% if ecriture.type is null %}
                     <tr>
                            <td data-label="{{ 'Date'|trans }}" class="text-center">
                                {% if first == 0 %} {{ i }} {% set i = i + 1 %} {% endif %}
                            </td>
                            <td data-label="{{ 'Date'|trans }}" class="text-center">
                                {% if first == 0 %}
                                    {{ ecriture.date|date('d/m/Y') }}
                                    {% set first = 1 %}
                                {% endif %}
                            </td>
                            <td data-label="{{ 'Compte'|trans }}" class="credit">
                                {#                                    {{ ecriture.debit ? ecriture.comptecredit : '' }} #}
                                {% if ecriture.comptedebit != compte %}
                                    {{ ecriture.comptedebit }} - {{ ecriture.libellecomptedebit }}
                                {% else %}
                                    {{ ecriture.comptecredit }} - {{ ecriture.libellecomptecredit }}
                                {% endif %}
                            </td>
                            {#                <td data-label="{{ 'Référence'|trans }}">#}

                            {#                </td>#}
                            <td data-label="{{ 'Libellé'|trans }}">
                                {#                                    {{ ecriture.debit ? ecriture.libelle : '' }}#}
                                {{ ecriture.libelle }}

                            </td>
                            <td data-label="{{ 'Crédit'|trans }}" class="text-end">
                                {% if ecriture.comptecredit != compte %}
                                    {{ ecriture.montant|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}
                                {% endif %}
                            </td>
                            <td data-label="{{ 'Débit'|trans }}" class="text-end">
                                {% if ecriture.comptedebit != compte %}
                                    {{ ecriture.montant|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}
                                {% endif %}
                            </td>
                            <!-- <td data-label="{{ 'solde'|trans }}" class="text-center">


                    {{ solde|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}
                </td> -->
                        </tr>
                    {% elseif ecriture.credit is not null %}
                        {% if ecriture.credit.transfert is not null %}
                            {% set transfert = 1 %}
                        {% endif %}
                        <tr>
                            <td data-label="{{ 'Date'|trans }}" class="text-center">
                                {% if first == 0 %} {{ i }} {% set i = i + 1 %} {% endif %}
                            </td>
                            <td data-label="{{ 'Date'|trans }}" class="text-center">
                                {% if first == 0 %}
                                    {{ ecriture.date|date('d/m/Y') }}
                                    {% set first = 1 %}
                                {% endif %}
                            </td>
                            <td data-label="{{ 'Compte'|trans }}" class="credit">
                                {#                                    {{ ecriture.debit ? ecriture.comptecredit : '' }} #}
                                {% if ecriture.comptedebit != compte %}
                                    {{ ecriture.comptedebit }} - {{ ecriture.libellecomptedebit }}
                                {% else %}
                                    {{ ecriture.comptecredit }} - {{ ecriture.libellecomptecredit }}
                                {% endif %}
                            </td>
                            {#                <td data-label="{{ 'Référence'|trans }}">#}

                            {#                </td>#}
                            <td data-label="{{ 'Libellé'|trans }}">
                                {#                                    {{ ecriture.debit ? ecriture.libelle : '' }}#}
                                {{ ecriture.credit ? ecriture.libelle : '' }}

                            </td>
                            <td data-label="{{ 'Crédit'|trans }}" class="text-end">
                                {% if ecriture.comptecredit != compte %}
                                    {{ ecriture.montant|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}
                                {% endif %}
                            </td>
                            <td data-label="{{ 'Débit'|trans }}" class="text-end">
                                {% if ecriture.comptedebit != compte %}
                                    {{ ecriture.montant|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}
                                {% endif %}
                            </td>
                            <!-- <td data-label="{{ 'solde'|trans }}" class="text-center">


                    {{ solde|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}
                </td> -->
                        </tr>
                    {% else %}
                        {% if ecriture.debit.transfert is not null %}
                            {% set transfert = 1 %}
                        {% endif %}
                        <tr>
                            <td data-label="{{ 'Date'|trans }}" class="text-center">
                                {% if first == 0 %} {{ i }} {% set i = i + 1 %} {% endif %}
                            </td>
                            <td data-label="{{ 'Date'|trans }}" class="text-center">
                                {% if first == 0 %}
                                    {{ ecriture.date|date('d/m/Y') }}
                                    {% set first = 1 %}
                                {% endif %}
                            </td>

                            <td data-label="{{ 'Compte'|trans }}" class="credit">
                                {% if ecriture.comptedebit != compte %}
                                    {{ ecriture.comptedebit }} - {{ ecriture.libellecomptedebit }}
                                {% else %}
                                    {{ ecriture.comptecredit }} - {{ ecriture.libellecomptecredit }}
                                {% endif %}
                                {#                                    {{ ecriture.credit ? ecriture.comptedebit : '' }}#}


                            </td>
                            {#                <td data-label="{{ 'Référence'|trans }}">#}

                            {#                </td>#}
                            <td data-label="{{ 'Libellé'|trans }}">
                                {{ ecriture.debit ? ecriture.libelle : '' }}
                                {#                                    {{ ecriture.credit ? ecriture.libelle : '' }}#}

                            </td>
                            <td data-label="{{ 'Crédit'|trans }}" class="text-end">
                                {% if ecriture.comptecredit != compte %}
                                    {{ ecriture.montant|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}
                                {% endif %}
                            </td>
                            <td data-label="{{ 'Débit'|trans }}" class="text-end">
                                {% if ecriture.comptedebit != compte %}
                                    {{ ecriture.montant|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}
                                {% endif %}

                            </td>
                            <!-- <td data-label="{{ 'solde'|trans }}" class="text-center">


                    {{ solde|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}
                </td> -->
                        </tr>
                    {% endif %}
                {% else %}
                    {% set transfert = 0 %}
                {% endif %}
            {% endfor %}
            <!-- <tr>
                <td data-label="colspan" colspan="5" class="text-bold text-end">
                    {{ 'Total'|trans }}
                </td>
                <td class="text-center text-bold">
                    {{ debit|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}
                </td>
                <td class="text-center text-bold">
                    {{ credit|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}
                </td>
                <td></td>
            </tr> -->
            </tbody>
        </table>
    </div>
{% endblock %}