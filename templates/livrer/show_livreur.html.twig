{% extends
    is_granted('ROLE_ADMIN') ? 'admin.html.twig' :
    is_granted('ROLE_SUPERVISEUR') ? 'admin.html.twig' :
    is_granted('ROLE_RH') ? 'rh.html.twig' :
    is_granted('ROLE_FINANCE') ? 'finance.html.twig' :
    is_granted('ROLE_CAISSE') ? 'caisse.html.twig' :
    is_granted('ROLE_STOCK') ? 'stock.html.twig' :
    is_granted('ROLE_LIVREUR') ? 'livreur.html.twig' :
    is_granted('ROLE_EMPLOYER') ? 'employe.html.twig' :
    is_granted('ROLE_LABORATOIRE') ? 'laboratoire.html.twig' :
    'layout.html.twig'
%}
{% block title %} {{ "Commande déjà Livrée"|trans }} - GNT Pharma {% endblock %}
{% block livraison %}active{% endblock %}
{% block all_livraison %}active{% endblock %}

{% block body %}
    <div class="container mt-4 fond-7 mb-5">
        <h3 class="mt-4 mb-5 text-bold">
            <i class="fa fa-shopping-cart me-2"></i>
            {{ "Commande à Livrer"|trans }}
        </h3>
        {% for message in app.flashes('echec') %}
            <div role="alert" class="alert alert-danger alert-dismissible fade show radius-10 shadow-black">
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                {{ message|trans }}
            </div>
        {% endfor %}
        <div class="row justify-content-end">
            <div class="col-lg-6">
                <table class="table table-success-light table-bordered table-hover table-striped">
                    <thead>
                    <tr>
                        <th>{{ 'N° Commande'|trans }}</th>
                        <th>{{ 'Client'|trans }}</th>
                        <th>{{ 'Date de commande'|trans }}</th>
                        <th>{{ 'Date de Paiement'|trans }}</th>

                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td>{{ commandereference.id }}</td>
                        <td>{{ commandereference.user.nom }}</td>
                        <td>{{ commandereference.date ? commandereference.date|date('d/m/Y') : '' }}</td>
                        <td>{{ commandereference.paiement ? commandereference.paiement.date|date('d/m/Y') : '' }}</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="row mt-5">
            <div class="col-lg-4">
                <table class="table table-success-light table-bordered table-hover table-striped">
                    <thead>
                    <tr>
                        <th>{{'N° Bordereau'|trans}}</th>
                        <th>{{"Date d'émission"|trans}}</th>

                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td>{{ livrer.id }}</td>
                        <td>{{ livrer.date|date('d/m/Y') }}</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <table class="table table-success-light table-bordered table-hover table-striped w-100 text-center">
            <thead>
            <tr>
                <th>{{ 'Référence'|trans }}</th>
                <th>{{ 'Désignation'|trans }}</th>
                <th>{{'N° Lot'|trans}}</th>
                <th>{{'Péremption'|trans}}</th>
                <th>{{ 'Quantité Commande'|trans }}</th>
                <th>{{'Quantité livrée'|trans}}</th>
                <th>{{'Quantité restante'|trans}}</th>
            </tr>
            </thead>
            <tbody>
            {% for  commande in livrer.livraison %}
                {% set ug = 0 %}
                <tr>
                    <td>{{ commande.produit.reference }}</td>
                    <td>{{ commande.produit.desigantion }}</td>
                    <td>{{ commande.lot }}</td>
                    <td>{{ commande.peremption|date('d/m/Y') }}</td>
                    <td>
                        {{ commande.quantitecommander }}
                        {% if commande.promotion is not null %}
                            {% if commande.promotion.premier is not null %}
                               {% set suite = 0 %}
                                {% if commandeproduit.quantitecommander / commandeproduit.promotion.cinquieme >= 1 %}

                                    {% set unite = (commandeproduit.quantitecommander / commandeproduit.promotion.cinquieme)|round(0, 'floor') %}
                                    {% set ug = ug + unite * commandeproduit.promotion.ugcinquieme %}
                                    {% set suite = commandeproduit.quantitecommander - unite * commandeproduit.promotion.cinquieme %}
                                   
                                    {% if suite / commandeproduit.promotion.quatrieme >= 1 %}
                                        {% set unite = (suite / commandeproduit.promotion.quatrieme)|round(0, 'floor') %}
                                        {% set ug = ug + unite * commandeproduit.promotion.ugquatrieme %}
                                        {% set suite = suite - unite * commandeproduit.promotion.quatrieme %}

                                        {% if suite / commandeproduit.promotion.troisieme >= 1 %}
                                            {% set unite = (suite / commandeproduit.promotion.troisieme)|round(0, 'floor') %}
                                            {% set ug = ug + unite * commandeproduit.promotion.ugtroisieme %}
                                            {% set suite = suite - unite * commandeproduit.promotion.troisieme %}
                                        
                                            {% if suite / commandeproduit.promotion.deuxieme >= 1 %}


                                                    {% set unite = (suite / commandeproduit.promotion.deuxieme)|round(0, 'floor') %}
                                                    {% set ug = ug + unite * commandeproduit.promotion.ugdeuxieme %}
                                                    {% set suite = suite - unite * commandeproduit.promotion.deuxieme %}

                                                    {% if suite / commandeproduit.promotion.premier >= 1 %}
                                                        {% set unite = (suite / commandeproduit.promotion.premier)|round(0, 'floor') %}
                                                        {% set ug = ug + unite * commandeproduit.promotion.ugpremier %}

                                                    {% endif %}                                                                 

                                            {% elseif suite / commandeproduit.promotion.premier >= 1 %}

                                                {% set unite = (suite / commandeproduit.promotion.premier)|round(0, 'floor') %}
                                                {% set ug = ug + unite * commandeproduit.promotion.ugpremier %}

                                            {% endif %}
                                        {% elseif suite / commandeproduit.promotion.deuxieme >= 1 %}
                                            {% set unite = (suite / commandeproduit.promotion.deuxieme)|round(0, 'floor') %}
                                            {% set ug = ug + unite * commandeproduit.promotion.ugdeuxieme %}
                                            {% set suite = suite - unite * commandeproduit.promotion.deuxieme %}

                                            {% if suite / commandeproduit.promotion.premier >= 1 %}
                                                {% set unite = (suite / commandeproduit.promotion.premier)|round(0, 'floor') %}
                                                {% set ug = ug + unite * commandeproduit.promotion.ugpremier %}

                                            {% endif %} 
                                    
                                        {% elseif suite / commandeproduit.promotion.premier >= 1 %}
                                            {% set unite = (suite / commandeproduit.promotion.premier)|round(0, 'floor') %}
                                            {% set ug = ug + unite * commandeproduit.promotion.ugpremier %}
                    
                                        {% endif %}
                                    {% elseif suite / commandeproduit.promotion.troisieme >= 1 %}
                                        {% set unite = (suite / commandeproduit.promotion.troisieme)|round(0, 'floor') %}
                                        {% set ug = ug + unite * commandeproduit.promotion.ugtroisieme %}
                                        {% set suite = suite - unite * commandeproduit.promotion.troisieme %}
                                    
                                        {% if suite / commandeproduit.promotion.deuxieme >= 1 %}


                                                {% set unite = (suite / commandeproduit.promotion.deuxieme)|round(0, 'floor') %}
                                                {% set ug = ug + unite * commandeproduit.promotion.ugdeuxieme %}
                                                {% set suite = suite - unite * commandeproduit.promotion.deuxieme %}

                                                {% if suite / commandeproduit.promotion.premier >= 1 %}
                                                    {% set unite = (suite / commandeproduit.promotion.premier)|round(0, 'floor') %}
                                                    {% set ug = ug + unite * commandeproduit.promotion.ugpremier %}

                                                {% endif %}                                                                 

                                        {% elseif suite / commandeproduit.promotion.premier >= 1 %}

                                            {% set unite = (suite / commandeproduit.promotion.premier)|round(0, 'floor') %}
                                            {% set ug = ug + unite * commandeproduit.promotion.ugpremier %}

                                        {% endif %}
                                    {% elseif suite / commandeproduit.promotion.deuxieme >= 1 %}
                                        {% set unite = (suite / commandeproduit.promotion.deuxieme)|round(0, 'floor') %}
                                        {% set ug = ug + unite * commandeproduit.promotion.ugdeuxieme %}
                                        {% set suite = suite - unite * commandeproduit.promotion.deuxieme %}

                                        {% if suite / commandeproduit.promotion.premier >= 1 %}
                                            {% set unite = (suite / commandeproduit.promotion.premier)|round(0, 'floor') %}
                                            {% set ug = ug + unite * commandeproduit.promotion.ugpremier %}

                                        {% endif %} 
                                   
                                    {% elseif suite / commandeproduit.promotion.premier >= 1 %}
                                        {% set unite = (suite / commandeproduit.promotion.premier)|round(0, 'floor') %}
                                        {% set ug = ug + unite * commandeproduit.promotion.ugpremier %}
                
                                    {% endif %}
                                {% elseif commandeproduit.quantitecommander / commandeproduit.promotion.quatrieme >= 1 %}

                                    {% set unite = (commandeproduit.quantitecommander / commandeproduit.promotion.quatrieme)|round(0, 'floor') %}
                                    {% set ug = ug + unite * commandeproduit.promotion.ugquatrieme %}
                                    {% set suite = commandeproduit.quantitecommander - unite * commandeproduit.promotion.quatrieme %}

                                     {% if suite / commandeproduit.promotion.troisieme >= 1 %}
                                        {% set unite = (suite / commandeproduit.promotion.troisieme)|round(0, 'floor') %}
                                        {% set ug = ug + unite * commandeproduit.promotion.ugtroisieme %}
                                        {% set suite = suite - unite * commandeproduit.promotion.troisieme %}
                                    
                                        {% if suite / commandeproduit.promotion.deuxieme >= 1 %}


                                                {% set unite = (suite / commandeproduit.promotion.deuxieme)|round(0, 'floor') %}
                                                {% set ug = ug + unite * commandeproduit.promotion.ugdeuxieme %}
                                                {% set suite = suite - unite * commandeproduit.promotion.deuxieme %}

                                                {% if suite / commandeproduit.promotion.premier >= 1 %}
                                                    {% set unite = (suite / commandeproduit.promotion.premier)|round(0, 'floor') %}
                                                    {% set ug = ug + unite * commandeproduit.promotion.ugpremier %}

                                                {% endif %}                                                                 

                                        {% elseif suite / commandeproduit.promotion.premier >= 1 %}

                                            {% set unite = (suite / commandeproduit.promotion.premier)|round(0, 'floor') %}
                                            {% set ug = ug + unite * commandeproduit.promotion.ugpremier %}

                                        {% endif %}
                                    {% elseif suite / commandeproduit.promotion.deuxieme >= 1 %}
                                        {% set unite = (suite / commandeproduit.promotion.deuxieme)|round(0, 'floor') %}
                                        {% set ug = ug + unite * commandeproduit.promotion.ugdeuxieme %}
                                        {% set suite = suite - unite * commandeproduit.promotion.deuxieme %}

                                        {% if suite / commandeproduit.promotion.premier >= 1 %}
                                            {% set unite = (suite / commandeproduit.promotion.premier)|round(0, 'floor') %}
                                            {% set ug = ug + unite * commandeproduit.promotion.ugpremier %}

                                        {% endif %} 
                                   
                                    {% elseif suite / commandeproduit.promotion.premier >= 1 %}
                                        {% set unite = (suite / commandeproduit.promotion.premier)|round(0, 'floor') %}
                                        {% set ug = ug + unite * commandeproduit.promotion.ugpremier %}
                
                                    {% endif %}
                                 {% elseif commandeproduit.quantitecommander / commandeproduit.promotion.troisieme >= 1 %}

                                    {% set unite = (commandeproduit.quantitecommander / commandeproduit.promotion.troisieme)|round(0, 'floor') %}
                                    {% set ug = ug + unite * commandeproduit.promotion.ugtroisieme %}
                                    {% set suite = commandeproduit.quantitecommander - unite * commandeproduit.promotion.troisieme %}

                                    {% if suite / commandeproduit.promotion.deuxieme >= 1 %}
                                        {% set unite = (suite / commandeproduit.promotion.deuxieme)|round(0, 'floor') %}
                                        {% set ug = ug + unite * commandeproduit.promotion.ugdeuxieme %}
                                        {% set suite = suite - unite * commandeproduit.promotion.deuxieme %}

                                        {% if suite / commandeproduit.promotion.premier >= 1 %}
                                            {% set unite = (suite / commandeproduit.promotion.premier)|round(0, 'floor') %}
                                            {% set ug = ug + unite * commandeproduit.promotion.ugpremier %}

                                        {% endif %} 
                                   
                                    {% elseif suite / commandeproduit.promotion.premier >= 1 %}
                                        {% set unite = (suite / commandeproduit.promotion.premier)|round(0, 'floor') %}
                                        {% set ug = ug + unite * commandeproduit.promotion.ugpremier %}
                
                                    {% endif %}
                                 {% elseif commandeproduit.quantitecommander / commandeproduit.promotion.deuxieme >= 1 %}

                                    {% set unite = (commandeproduit.quantitecommander / commandeproduit.promotion.deuxieme)|round(0, 'floor') %}
                                    {% set ug = ug + unite * commandeproduit.promotion.ugdeuxieme %}
                                    {% set suite = commandeproduit.quantitecommander - unite * commandeproduit.promotion.deuxieme %}

                                    {% if suite / commandeproduit.promotion.premier >= 1 %}
                                        {% set unite = (suite / commandeproduit.promotion.premier)|round(0, 'floor') %}
                                        {% set ug = ug + unite * commandeproduit.promotion.ugpremier %}
                
                                    {% endif %}
                                 {% elseif commandeproduit.quantitecommander / commandeproduit.promotion.premier >= 1 %}

                                    {% set unite = (commandeproduit.quantitecommander / commandeproduit.promotion.premier)|round(0, 'floor') %}
                                    {% set ug = ug + unite * commandeproduit.promotion.ugpremier %}
                                    

                                {% endif %}
                                <span class="badge bg-danger">
                                    +{{ ug }} U.G.
                            </span>
                            {% endif %}
                        {% endif %}
                    </td>
                    <td class="text-center">
                        {{ commande.quantitelivrer }}
                    </td>
                    <td class="text-center">
                        {{ commande.restealivrer }}
                    </td>
                </tr>
                {% set entete = commande.livrer.id %}
            {% endfor %}
            </tbody>
        </table>
        <div class="col-md-3 offset-md-4 mt-5 mb-5 p-3 fond-7">
            <div class="centrer">
                <a id="valid" href="" class="btn btn-success float-end" data-bs-toggle="modal" data-bs-target="#livreurshow">
                    <i class="fa fa-check"></i>
                    {{ "Valider"|trans }}
                </a>
            </div>
        </div>
    </div>
    <div class="modal fade" id="livreurshow" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content text-center">
                <div class="modal-header">
                    <h4 class="modal-title fs-5" id="exampleModalLabel">
                        <i class="fa-solid fa-signature"></i>
                        {{ 'Signature client'|trans }}
                    </h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            aria-label="Close">

                    </button>
                </div>
                <div class="modal-body px-5 pb-5">
                    <div id="signature" class="col-lg-12">

                    </div>
                    <input id="signature64" name="signed" style="display: none"/>
                    <div>
                 {{ form_start(form) }}
                {{ form_widget(form) }}
                {{ form_rest(form) }}
                </div>
                </div>
                <div id="source"></div>
                
                
                <div class="modal-footer centrer">
                    <button id="clear" class="btn btn-success-light me-3">
                        {{ 'Recommencer'|trans }}
                    </button>
                    <button type="button" class="btn btn-success" onclick="image({{ livrer.id }})" id="valider">
                        <i class="fa fa-check"></i>
                        {{ 'Valider'|trans }}
                    </button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
