<form method="post" title="{{ 'Supprimer'|trans }}" action="{{ path('stock_epuise', {'id': stock.id}) }}" onsubmit="return confirm('{{ 'Etes vous sûr de vouloir supprimer ce produit du stock?'|trans }}');" style="display: inline;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ stock.id ~ 'lot' ~ stock.lot) }}">
    <button class="btn btn-danger">
        <i class="fa fa-trash"></i> stock épuisé
    </button>
</form>
