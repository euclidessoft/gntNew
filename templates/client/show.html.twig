{% extends
    is_granted('ROLE_ADMIN') ? 'admin.html.twig' :
    is_granted('ROLE_SUPERVISEUR') ? 'admin.html.twig' :
    is_granted('ROLE_RH') ? 'rh.html.twig' :
    is_granted('ROLE_FINANCE') ? 'finance.html.twig' :
    is_granted('ROLE_STOCK') ? 'stock.html.twig' :
    is_granted('ROLE_LIVREUR') ? 'livreur.html.twig' :
    is_granted('ROLE_EMPLOYER') ? 'employe.html.twig' :
    'layout.html.twig'
%}

{% block title %} {{ 'user'|trans }} {% endblock %}
{% block client_suivi %} active{% endblock %}
{% block body %}
{#    {{ include('security/security/profile-info.html.twig') }}#}


    <div class="col-lg-7 mt-5 mb-5 p-5 fond-7">
        <h3 class="text-bold">
            <i class="fa fa-user me-2"></i>
            {{ 'user'|trans }}
        </h3>
        <div class="row">
            {% for message in app.flashes('notice') %}
                <div class="col-lg-12 mt-4 alert alert-success alert-dismissible fade show radius-10 shadow-black"
                     role="alert">
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-hidden="true">&times;</button>
                    {{ message|trans }}
                </div>
            {% endfor %}
            <div class="col-12">
                {% if user.enabled == 1 %}
                    <button class="btn btn-danger" id="btn{{ user.id }}" onclick="userdisable({{ user.id }})" title="{{ "Désactiver ce user"|trans }}">
                        <i class="fa fa-user-lock"></i> Deactiver
                    </button>
                {% else %}
                    <button class="btn btn-green" id="btn{{ user.id }}" onclick="userenable({{ user.id }})" title="{{ "Activer ce user"|trans }}">
                        <i class="fa fa-user-check"></i> Activer
                    </button>
                {% endif %} 
                <a class="btn btn-success" href="{{ path('vente_chiffre_client', {'client': user.id})}}"><i class="fas fa-chart-line"></i> Analyse<a>
            </div>
            <div class="col-lg-3 mt-5 text-center">
                <img src="{{ asset('images/team_1.avif') }}" alt="" class="w-100 img-fluid rounded">
                {#                                                    {% if user.sexe == "Monsieur" %}#}
                {#                                                     <img src="{{asset('images/avatar.jpg') }}" width="100" alt="Photo" class="rounded-circle" />#}
                {#                                                     {% else %}#}
                {#                                                     <img src="{{asset('images/avatar-femme.jpg') }}" width="100" alt="Photo" class="rounded-circle" />#}
                {#                                                     {% endif %}#}
                {#                                                     <h6 class="mt-3">{{ user.bloodgroup }}</h6>#}
            </div>
            <div class="col-lg-9 mt-5">
                <div class="row">
                    <div class="col-lg-3 text-end text-bold">{{ 'Prénom'|trans }}</div>
                    <div class="col-lg-9 ms-2 ms-n4">{{ user.prenom }}</div>
                    <div class="col-lg-3 text-end text-bold">{{ 'Nom'|trans }}</div>
                    <div class="col-lg-9 ms-n4">{{ user.nom }}</div>
                    <div class="col-lg-3 text-end text-bold">{{ 'Téléphone'|trans }}</div>
                    <div class="col-lg-9 ms-n4">{{ user.phone }}</div>
                    <div class="col-lg-3 text-end text-bold">{{ 'Email'|trans }}</div>
                    <div class="col-lg-9 ms-n4">{{ user.email }}</div>
                    <div class="col-lg-3 text-end text-bold">{{ 'Adresse'|trans }}</div>
                    <div class="col-lg-9 ms-n4">{{ user.adresse }}</div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
