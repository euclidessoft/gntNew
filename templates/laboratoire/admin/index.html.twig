{% extends
    is_granted('ROLE_ADMIN') ? 'admin.html.twig' :
    is_granted('ROLE_SUPERVISEUR') ? 'admin.html.twig' :
    is_granted('ROLE_RH') ? 'rh.html.twig' :
    is_granted('ROLE_FINANCE') ? 'finance.html.twig' :
    is_granted('ROLE_CAISSE') ? 'caisse.html.twig' :
    is_granted('ROLE_STOCK') ? 'stock.html.twig' :
    is_granted('ROLE_LIVREUR') ? 'livreur.html.twig' :
    is_granted('ROLE_EMPLOYER') ? 'employe.html.twig' :
    is_granted('ROLE_LABORATOIRE') ? 'laboratoire.html.twig' :
    'layout.html.twig'
%}

{% block title %}Laboratoire index{% endblock %}

{% block body %}
    <h1>Laboratoire index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Username</th>
                <th>Password</th>
                <th>Email</th>
                <th>Prenom</th>
                <th>Nom</th>
                <th>Phone</th>
                <th>Adresse</th>
                <th>Fonction</th>
                <th>Roles</th>
                <th>ResetToken</th>
                <th>Enabled</th>
                <th>Client</th>
                <th>Livreur</th>
                <th>Boitepostale</th>
                <th>Siteweb</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for laboratoire in laboratoires %}
            <tr>
                <td>{{ laboratoire.id }}</td>
                <td>{{ laboratoire.username }}</td>
                <td>{{ laboratoire.password }}</td>
                <td>{{ laboratoire.email }}</td>
                <td>{{ laboratoire.prenom }}</td>
                <td>{{ laboratoire.nom }}</td>
                <td>{{ laboratoire.phone }}</td>
                <td>{{ laboratoire.adresse }}</td>
                <td>{{ laboratoire.fonction }}</td>
                <td>{{ laboratoire.roles ? laboratoire.roles|join(', ') : '' }}</td>
                <td>{{ laboratoire.resetToken }}</td>
                <td>{{ laboratoire.enabled ? 'Yes' : 'No' }}</td>
                <td>{{ laboratoire.client ? 'Yes' : 'No' }}</td>
                <td>{{ laboratoire.livreur ? 'Yes' : 'No' }}</td>
                <td>{{ laboratoire.boitepostale }}</td>
                <td>{{ laboratoire.siteweb }}</td>
                <td>
                    <a href="{{ path('app_laboratoire_show', {'id': laboratoire.id}) }}">show</a>
                    <a href="{{ path('app_laboratoire_edit', {'id': laboratoire.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="17">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_laboratoire_new') }}">Create new</a>
{% endblock %}
