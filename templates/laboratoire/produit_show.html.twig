{% extends
    is_granted('ROLE_ADMIN') ? 'admin.html.twig' :
    is_granted('ROLE_SUPERVISEUR') ? 'admin.html.twig' :
    is_granted('ROLE_RH') ? 'rh.html.twig' :
    is_granted('ROLE_FINANCE') ? 'finance.html.twig' :
    is_granted('ROLE_CAISSE') ? 'caisse.html.twig' :
    is_granted('ROLE_STOCK') ? 'stock.html.twig' :
    is_granted('ROLE_LIVREUR') ? 'livreur.html.twig' :
    is_granted('ROLE_EMPLOYER') ? 'employe.html.twig' :
    is_granted('ROLE_LABORATOIRE') ? 'laboratoire.html.twig' :
    'layout.html.twig'
%}
{% block home %}active{% endblock %}
{% block body %}

    {% for message in app.session.flashbag.get('notice') %}
        <div class="container mt-5 mb-5">
            <div role="alert" class="alert alert-danger alert-dismissible">
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-hidden="true">&times;</button>
                {{ message|trans }}
            </div>
        </div>
    {% endfor %}
    <div class="col-md-8 offset-md-2 my-5">
        <div class="row justify-content-center">
            <div class="col-lg-3 h-100 col-md-4 col-sm-6 mt-3 mb-3">
                <div class="card border-green">
                    <div class="card-header bg-success-light text-green">
                        <div class="row">
                            <div class="col-12">
                                <i class="fa-solid fa-truck-fast fa-5x"></i>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 text-end">
                                <div class="text-bold">{{ produit.stock }}</div>
                                <div>
                                    {{'restant(s)'|trans}}
                                </div>
                                <br>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-light bt-green">
                    
                        <div class="clearfix"></div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 h-100 col-md-4 col-sm-6 my-3">
                <div class="card border-green">
                    <div class="card-header bg-green">
                        <div class="row">
                            <div class="col-12">
                                <i class="fa-solid fa-truck fa-5x"></i>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 text-end">
                                <div class="text-bold">{{vendu}}</div>
                                <div>
                                    {{ 'Vendu(s)'|trans }}
                                </div>
                                <br>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-light bt-green">
                   
                        <div class="clearfix"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
