{% extends 'client.html.twig' %}
{% block title %} {{ "Officine"|trans }} - GNT Pharma {% endblock %}
{% block officine %}active{% endblock %}

{% block body %}
    <div class="container mt-4 fond-7">
        <h3 class="mt-4 mb-5 text-bold">
            <i class="fas fa-staff-snake fa-lg"></i>
            {{ "Officine"|trans }} :  {{ "Factures"|trans }}
        </h3>
        <ul class="nav nav-tabs mb-4">
            <li class="nav-item">
                <a class="nav-link active" href="#">{{ 'Facture'|trans }}</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="{{ path('avoir_officine') }}">{{'Avoir'|trans}}</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="{{ path('finance_avantage_client')}}">{{'Avantages'|trans}}</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="{{ path('commande_panier_credit') }}">{{'Dette'|trans}}</a>
            </li>
        </ul>
        <table class="table table-success-light table-bordered table-hover table-striped w-100 my-4">
            <thead>
            <tr>
                <th>{{ 'Date'|trans }}</th>
                <th>{{'Numero Facture'|trans}}</th>
                <th>{{'Mode Paiement'|trans}}</th>
                <th>{{ 'Montant'|trans }}</th>
                <th>{{'Date due'|trans}}</th>
            </tr>
            </thead>
            <tbody>
            {% set tva = 0 %}
            {% set prelevement = 0 %}
            {% set montant = 0 %}
            {% set total = 0 %}
            {% set avance = 0 %}
            {% for commande in commandes %}
                <tr>
                    <td>{{ commande.traitement|date('d/m/Y') }}</td>
                    <td> {{ commande.id}}-{{ commande.numerofacture }}</td>
                    <td>{{ commande.credit == true ? 'CREDIT' : "" }}</td>
                  <td>{{ (commande.montant - commande.tva -commande.acompte )|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}
                  {% set montant = montant + (commande.montant - commande.tva - commande.acompte ) %}
                  {% set avance = avance + commande.versement %}
                  {% set total = total + commande.montant %}
                  {% set tva = tva + commande.tva %}
                  {% set prelevement = prelevement + commande.acompte %}
                  </td>
                  <td></td>
                </tr>
            {% else %}
            {% endfor %}
            </tbody>
        </table>

         <table class="table table-success-light table-bordered table-hover table-striped w-100 my-4 mt-4">
            <thead>
            <tr>
                <th>{{ 'TAUX TVA'|trans }}</th>
                <th>{{'TAUX PRELEVEMENT'|trans}}</th>
                <th>{{'T.V.A'|trans}}</th>
                <th>{{ 'TOTAL H.T'|trans }}</th>
            </tr>
            </thead>
            <tbody>
                <tr>
                    <td>0,000%</td>
                    <td>2%</td>
                    <td>{{ tva|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}</td>
                   <td>{{ montant|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}</td>
                </tr>
            </tbody>
        </table>

        <table class="table table-success-light table-bordered table-hover table-striped w-100 my-4 mt-4">
            <thead>
            <tr>
                <th>{{'PRELEVEMENT'|trans}} {{ prelevement|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}</th>
                <th>{{'TOTAL T.V.A'|trans}} {{ tva|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}</th>
                <th>{{ 'TOTAL T.T.C'|trans }} {{ total|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}</th>
            </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="3"> AVANCE {{ avance|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}</td>
                </tr>
                 <tr>
                    <td colspan="3"> RESTE {{ (total - avance)|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}
                   <span id="total" class="text-nowrap" style="display:none;">{{ (total - avance)|number_format(2, '.' , '') }}</span>
                    </td>
                </tr>
                 <tr>
                    <td colspan="3">SOIT À VOTRE DEBIT <b id="conversion"></b><b id="virgule"></b> <b>franc CFA TTC</b></td>
                </tr>
            </tbody>
        </table>

    </div>

{% endblock %}
