{% extends
    is_granted('ROLE_ADMIN') ? 'admin.html.twig' :
    is_granted('ROLE_SUPERVISEUR') ? 'admin.html.twig' :
    is_granted('ROLE_RH') ? 'rh.html.twig' :
    is_granted('ROLE_FINANCE') ? 'finance.html.twig' :
    is_granted('ROLE_CAISSIER') ? 'caisse.html.twig' :
    is_granted('ROLE_STOCK') ? 'stock.html.twig' :
    is_granted('ROLE_LIVREUR') ? 'livreur.html.twig' :
    is_granted('ROLE_EMPLOYER') ? 'employe.html.twig' :
    is_granted('ROLE_LABORATOIRE') ? 'laboratoire.html.twig' :
    'layout.html.twig'
%}
{% block title %} {{ "Officine"|trans }} - GNT Pharma {% endblock %}
{% block commande %}active{% endblock %}
{% block suivi %}active{% endblock %}

{% block body %}
    <div class="container mt-4 fond-7">
        <h3 class="mt-4 mb-1 text-bold">
            <i class="fa fa-user fa-lg"></i>
            {{ user.nom ~ " " ~ user.prenom}}  
        </h3>
        <h4 class="mt-2 mb-5 text-bold">
            <i class="fa fa-list fa-lg"></i>
            {{ "Releve Factures"|trans }} {{quinzaine}} {{ "quinzaine"}} {{ mois|date("m/Y")}}  
        </h4>
        <ul class="nav nav-tabs mb-4">
            <li class="nav-item">
                <a class="nav-link" href="{{ path('commande_panier_suivi') }}">
                    {{ 'Validation paiement'|trans }}
                </a>
            </li>
            {% if is_granted("ROLE_FINANCE")%}
            <li class="nav-item">
                <a class="nav-link" href="{{ path('commande_panier_validation_credit') }}">
                    {{'Validation crédit'|trans}}
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="{{ path('commande_panier_credit') }}">
                    {{'Commandes à crédit'|trans}}
                </a>
            </li>
            {% endif %}
            <li class="nav-item">
                <a class="nav-link" href="{{ path('commande_panier_history') }}">
                    {{'Commandes déjà payées'|trans}}
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link active " href="#">
                    {{'Relevé Factures'|trans}}
                </a>
            </li>
        </ul>
          <table class="table table-success-light table-bordered table-hover table-striped w-100 my-4">
            <thead>
            <tr>
                <th colspan="6">{{ 'factures'|trans }}</th>
            </tr>
            <tr>
                <th>{{ 'Date Commande'|trans }}</th>
                <th>{{ 'Date Traitement'|trans }}</th>
                <th>{{'Numero Facture'|trans}}</th>
                <th>{{'Mode Paiement'|trans}}</th>
                <th>{{ 'Montant'|trans }}</th>
                <th>{{'Date due'|trans}}</th>
            </tr>
            </thead>
            <tbody>
            {% set tva = 0 %}
            {% set prelevement = 0 %}
            {% set montant = 0 %}
            {% set total = 0 %}
            {% set avance = 0 %}
            {% for commande in commandes %}
                <tr>
                    <td>{{ commande.date }}</td>
                    <td>{{ commande.traitement }}</td>
                    <td> {{ commande.numerofacture}}</td>
                    <td>Credit</td>
                  <td>{{ commande.montant|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}
                  {# {% set montant = montant + (commande.montant - commande.tva - commande.acompte ) %}
                  {% set avance = avance + commande.versement %}
                  {% set total = total + commande.montant %}
                  {% set tva = tva + commande.tva %}
                  {% set prelevement = prelevement + commande.acompte %} #}
                  </td>
                  <td>
                  {{ commande.datedue }}
                  </td>
                </tr>
            {% else %}
            {% endfor %}
            </tbody>
        </table><table class="table table-success-light table-bordered table-hover table-striped w-100 my-4">
            <thead>
            <tr>
                <th colspan="2">{{ 'Avoirs'|trans }}</th>
            </tr><tr>
                <th>{{ 'Date'|trans }}</th>
                <th>{{'Montant'|trans}}</th>
            </tr>
            </thead>
            <tbody>
           
            {% set montantavoir = 0 %}
            {% for avoir in avoirs %}
                <tr>
                    <td>{{ avoir.date }}</td>
                  <td>{{ avoir.montant|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}
                  {# {% set montantavoir = montantavoir + avoir.montant %}
                  {% set avance = avance + avoir.montant %} #}
                 
                  </td>
                </tr>
            {% else %}
            {% endfor %}
            </tbody>
        </table>

         <table class="table table-success-light table-bordered table-hover table-striped w-100 my-4 mt-4">
            <thead>
            <tr>
                <th>{{ 'TAUX TVA'|trans }}</th>
                <th>{{'TAUX PRELEVEMENT'|trans}}</th>
                <th>{{'T.V.A'|trans}}</th>
                <th>{{ 'TOTAL H.T'|trans }}</th>
            </tr>
            </thead>
            <tbody>
                <tr>
                    <td>0,000%</td>
                    <td>2%</td>
                    <td>{{ releve ? releve.tva|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') : '' }}</td>
                    <td>{{ releve ? releve.ht|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') : '' }}</td>
                </tr>
            </tbody>
        </table>

        <table class="table table-success-light table-bordered table-hover table-striped w-100 my-4 mt-4">
            <thead>
            <tr>
                <th>{{'PRELEVEMENT'|trans}} {{ releve ? releve.prelevement|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') : '' }}</th>
                <th>{{'TOTAL T.V.A'|trans}} {{ releve ? releve.tva|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') : '' }}</th>
                <th>{{ 'TOTAL T.T.C'|trans }} {{releve ? releve.total|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') : '' }}</th>
            </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="3"> AVANCE {{ releve ? releve.avance|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') : '' }}</td>
                </tr>
                 <tr>
                    <td colspan="3"> RESTE {{ releve ? releve.reste|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') : '' }}
                   <span id="total" class="text-nowrap" style="display:none;">{{ releve ? releve.reste|number_format(2, '.' , '') : '' }}</span>
                    </td>
                </tr>
                 <tr>
                    <td colspan="3">SOIT À VOTRE DEBIT <b id="conversion"></b><b id="virgule"></b> <b>franc CFA TTC</b></td>
                </tr>
            </tbody>
        </table>

    </div>

{% endblock %}
