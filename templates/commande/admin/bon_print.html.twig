<!doctype html>
<html lang="en">

<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">

    <title>&nbsp;</title>
    <style>
        .titre {
            font-family: Verdana, Geneva, Tahoma, sans-serif;
            font-size: 30px;
            font-weight: bold;
            color: #039c4f;
        }

        .text {
            font-size: 14px;
        }

        .badge {
            background-color: red !important;
        }

        @media print {
            .table-success-light {
                color: #000 !important;
            }

            .table-bordered {
                border: 1px solid #000 !important;
            }

            thead {
                background-color: #c5fbae !important;
                color: #000;
            }

            .tt {
                display: inline-block;
                border: none;
                width: 180px !important;
            }
        }
    </style>

</head>

<body onload="print()" onafterprint="history.back()">
    <div class="container-fluid">



        <div class="col-lg-8 offset-lg-2">
            <div class="row" style="border-bottom: 1px solid #039c4f;padding-bottom: 20px;">
                <div class="col-2">
                    <img src="{{ asset('images/gntpharma.jpeg') }}" alt="Logo" class="w-100">
                </div>
                <div class="col-10 text-center">
                    <div class="row">
                        <div class="col-12 titre text-center">
                            GNT PHARMA
                        </div>
                        <div class="col-12 text">
                            BP : 3582 Yaoundé – Cameroun, NGOUSSO
                            <br>
                            Montée Éleveur Immeuble Sainte Marie
                        </div>
                        <div class="col-12 text">
                            +237 69 71 49 4 12 / +237 67 52 47 865
                        </div>
                        <div class="col-12 text">
                            info@gntpharma-cameroun.com / www.gnt-pharma.com
                        </div>
                    <div class="col-12 text">
                        RCCM N° : RC/YAE/2023/M/105 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;NIU : M122217881373Q
                    </div>
                    {# <div class="col-12 text">
                       SARL au CAPITAL de 100 000 000 F CFA
                    </div> #}
                        <!-- <div class="col-12 text-bold">

                </div> -->
                    </div>
                </div>
            </div>
           <h3 class="text-center text-bold text-uppercase mt-4">
            {{ ' Bon de Commande'|trans }}
        </h3>
        <h6 class="text-center text-bold text-uppercase mb-3">
        {{ 'Numero'|trans }} : BC{{ commande.id}}{{ commande.numerofacture }}
        </h6>

            <div class="row">
            <div class="col-12">
                    <table class="table table-success-light text-center table-bordered">
                        <thead>
                            <tr>
                                <th>{{ 'Date Commande'|trans }}</th>
                                <th>{{ 'Numero Commande'|trans }}</th>
                        <th>{{ 'NIU'|trans }}</th>
                        <th>{{ 'RCCM'|trans }}</th>
                        {% if commande.credit == 1 and commande.payer == 0 %}
                        <th>{{ 'date d\'echeance de paiement'|trans }}</th>
                        {% endif %}
                        <th>{{ 'Passé par'|trans }}</th>

                                {# <th>{{ 'Status Commande'|trans }}</th> #}
                                {#            <th>Date de Livraison</th>#}
                            </tr>
                        </thead>
                        <tbody>
                            <td>{{ commande.date|date('d/m/Y') }}</td>
                            <td>{{ commande.id }}</td>
                        <td>{{ commande.user.niu }}</td>
                        <td>{{ commande.user.rccm }}</td>
                         {% if commande.credit == 1 and commande.payer == 0 %}
                             <td> {{ commande.date|date_modify('+10 days')|date('d/m/Y') }}</td>
                        {% endif %}
                        <td>{{ commande.pharmaemploye ? commande.pharmaemploye.nom ~" "~ commande.pharmaemploye.prenom : commande.user.nom ~" "~ commande.user.prenom }}</td>
                                                    {# <td>
                                {% if commande.payer == 0 %}
                                <span class="text-danger">Non payée</span>
                                {% else %}
                                <span class="text-success">Payée</span>
                                {% endif %}
                            </td> #}
                            {#        <td> </td>#}
                        </tbody>
                    </table>
                </div>
            </div>
            {% set total=0 %}
            {% set reduction=0 %}
            {% set tva=0 %}
            <table class="table table-success-light text-center table-bordered mt-2">
                <thead>
                    <tr>
                        <th>{{ 'CIP'|trans }}</th>
                        <th class="tt">{{ 'Désignation'|trans }}</th>
                        <th>{{'Qté Commandée'|trans}}</th>
                        {#            <th>Qté Livree</th>#}
                        {#            <th>Qté Restante</th>#}
                        {# <th class="text-nowrap">{{'Prix Ces.'|trans}}</th>
                        <th>{{ 'Réduc.'|trans }}</th>
                        <th>{{ 'TVA'|trans }}</th>
                        <th>{{ 'Prix Public'|trans }}</th>
                        <th>{{ 'Montant'|trans }}</th> #}
                    </tr>
                </thead>
                <tbody>
                    {% for commandeproduit in commandeproduits %}
                    {% set reductionproduit = 0 %}
                    <tr>
                        <td> {{ commandeproduit.produit.reference }} </td>
                        <td>{{ commandeproduit.produit.desigantion }} </td>
                        <td>
                            {{ commandeproduit.quantite }}
                            {% if commandeproduit.ug != 0%}
                            <span class="badge bg-danger">
                                        + {{ commandeproduit.ug }} U.G
                            </span>
                        {% endif %}
                        </td>
                        {#                <td>#}
                        {#                {{ commande.livraison ? commance.quantitelivrer : '' }}#}
                        {#                </td>#}
                        {#                <td> </td>#}
                        {# <td>
                            {{ commandeproduit.produit.prix|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}

                        </td>
                        <td>
                            {% if commandeproduit.promotion is not null %}
                            {% if commandeproduit.promotion.reduction is not null %}
                            {% set reductionproduit =  commandeproduit.quantite * commandeproduit.session * commandeproduit.promotion.reduction /100 %}

                            {% set reduction =  reduction + reductionproduit %}
                            <span class="badge bg-danger">
                                -{{ commandeproduit.session * commandeproduit.promotion.reduction /100 }} F
                            </span>
                            {% else %}
                            -
                            {% endif %}
                            {% else %}
                            -
                            {% endif %}
                        </td>
                        <td>
                            {% if commandeproduit.tva != 0 %}
                            {% set tva = tva + (((commandeproduit.quantite * commandeproduit.session) - reductionproduit) * 0.1925) %}
                            {% if commandeproduit.promotion is not null %}
                            {% if commandeproduit.promotion.reduction is not null %}
                            {{ (commandeproduit.session - (commandeproduit.session * commandeproduit.promotion.reduction /100)) * 0.1925 }}
                            {% else %}
                            {{ commandeproduit.session  * 0.1925 }}
                            {% endif %}
                            {% else %}
                            {{ commandeproduit.session  * 0.1925 }}
                            {% endif %}
                            {% else %}
                            -
                            {% endif %}
                        </td>
                        <td>{{ commandeproduit.produit.prixpublic|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}</td>
                        <td>
                            {{ (commandeproduit.quantite * commandeproduit.produit.prix)|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}
                            {% set total = total + (commandeproduit.quantite * commandeproduit.produit.prix) %}
                        </td> #}



                    </tr>
                    {% endfor %}
                    {# <tr>
                        <td colspan="7" class="text-end fw-bolder">
                            {{ "Total HT"|trans }}
                        </td>
                        <td>
                            <span id="" class="fw-bolder">{{ total|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}</span>
                        </td>
                    </tr>
                    {% if reduction != 0 %}
                    <tr>
                        <td colspan="7" class="text-end fw-bolder">
                            {{ "Total Réduction"|trans }}
                        </td>
                        <td>
                            <span id="" class="fw-bolder">{{ reduction|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}</span>
                        </td>
                    </tr>
                    {% endif %}
                    <tr>
                        <td colspan="7" class="text-end">
                            {{ "Total TVA"|trans }}
                        </td>
                        <td>
                            <span id="">{{ tva|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}</span>
                        </td>
                    </tr>
            <tr>
                <td colspan="7" class="text-end">
                    {{ "Prélèvement (2%)"|trans }}
                </td>
                <td class="text-center">
             
                    <span id="">{{ commande.acompte != 0 ? commande.acompte|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') : ''}}</span>
                    <input type="hidden" value="{{ tva }}" id="totaltamp"/>
                </td>
            </tr>

                    <tr>
                        <td colspan="7" class="text-end fw-bolder">
                            {{ "Net à payer"|trans }}
                        </td>
                        <td>
                            <span class="fw-bolder">{{ (total+ commande.acompte + tva -reduction)|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}</span>
                             <span id="total" class="text-nowrap" style="display:none;">{{ (total + commande.acompte + tva - reduction)|number_format(2, '.' , '') }}</span>
                        </td>
                    </tr> #}
                </tbody>
            </table>
           
            {{ include('includes/javascript.html.twig') }}

</body>

</html>